# One personal memory per deployment. Corporate memory is a separate later project/instance.
MEMORY_SCOPE=personal:owner
MEMORY_BACKEND=reference
MEMORY_DATA_DIR=data
MEMORY_CLIENTS_FILE=config/clients.json
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8080
MEMORY_WORKER_ENABLED=true
MEMORY_EXTRACTION_MODE=provided
MEMORY_ALLOW_MODEL_CALLS=false
MEMORY_GRAPHITI_ENABLED=false

# Only when enabling Neo4j / models. Local OpenAI-compatible endpoints are also configurable.
MEMORY_NEO4J_URI=bolt://localhost:7687
MEMORY_NEO4J_DATABASE=neo4j
MEMORY_NEO4J_USER=neo4j
MEMORY_NEO4J_PASSWORD=
MEMORY_MODEL_BASE_URL=https://api.openai.com/v1
MEMORY_MODEL_API_KEY=
MEMORY_MODEL_NAME=gpt-4.1-mini
MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIM=1536
MEMORY_TIMEOUT_SECONDS=120
GRAPHITI_TELEMETRY_ENABLED=false
SEMAPHORE_LIMIT=3

# Link proposals (AM-003). lexical = offline; embedding uses MEMORY_EMBEDDING_* and needs MEMORY_ALLOW_MODEL_CALLS=true.
MEMORY_SIMILARITY_MODE=lexical
# MEMORY_PROPOSAL_THRESHOLD=0.5   # default 0.5 lexical, 0.6 embedding (uncalibrated)
MEMORY_JUDGE_ENABLED=false
MEMORY_MAX_JUDGE_CALLS=20
MEMORY_AUTO_PROPOSE=false
