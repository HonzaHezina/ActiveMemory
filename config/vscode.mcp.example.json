{
  "inputs": [
    {"id": "memory-key", "type": "promptString", "description": "Active Memory read key", "password": true}
  ],
  "servers": {
    "active-memory": {
      "type": "stdio",
      "command": "/ABSOLUTE/PATH/active-memory/.venv/bin/active-memory-mcp",
      "env": {
        "MEMORY_API_URL": "http://127.0.0.1:8080",
        "MEMORY_CLIENT_API_KEY": "${input:memory-key}",
        "MEMORY_MCP_ALLOW_WRITE": "false"
      }
    }
  }
}
