  "components": {
    "schemas": {
      "Extraction": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "maxItems": 24,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Extraction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Item": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "label": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "title": "Label"
          },
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Summary"
          },
          "quote": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Quote"
          },
          "themes": {
            "items": {
              "type": "string",
              "maxLength": 180,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 8,
            "title": "Themes"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 0.5
          },
          "valid_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid From"
          },
          "valid_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "label",
          "summary",
          "quote"
        ],
        "title": "Item"
      },
      "Kind": {
        "type": "string",
        "enum": [
          "Theme",
          "Thought",
          "Fact",
          "Question",
          "Goal",
          "Decision"
        ],
        "title": "Kind"
      },
      "LinkInput": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "target_id": {
            "type": "string",
            "title": "Target Id"
          },
          "relation": {
            "$ref": "#/components/schemas/Relation"
          },
          "episode_id": {
            "type": "string",
            "title": "Episode Id"
          },
          "quote": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "target_id",
          "relation",
          "episode_id",
          "quote"
        ],
        "title": "LinkInput"
      },
      "Message": {
        "properties": {
          "source_system": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "title": "Source System"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "message_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Message Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool",
              "system"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 1,
            "title": "Content"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "extraction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Extraction"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_system",
          "conversation_id",
          "message_id",
          "role",
          "content",
          "occurred_at"
        ],
        "title": "Message"
      },
      "Query": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 12
          },
          "include_candidates": {
            "type": "boolean",
            "title": "Include Candidates",
            "default": false
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "max_chars": {
            "type": "integer",
            "maximum": 32000.0,
            "minimum": 100.0,
            "title": "Max Chars",
            "default": 8000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "Query"
      },
      "Relation": {
        "type": "string",
        "enum": [
          "ABOUT",
          "SUPPORTS",
          "REFINES",
          "CONTRADICTS",
          "SUPERSEDES"
        ],
        "title": "Relation"
      },
      "Review": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Review"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
